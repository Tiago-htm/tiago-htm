---
import { Icon } from 'astro-icon/components';
---

<footer class="footer">
  <div class="footer-inner">

    <div class="contact">
      <a href="mailto:tiagovilela019@gmail.com">tiagovilela019@gmail.com</a>
      <a href="https://github.com/Tiago-htm" target="_blank" aria-label="GitHub">
        <Icon name="lucide:github" />
      </a>
      <a href="https://linkedin.com/in/seu-usuario" target="_blank" aria-label="LinkedIn">
        <Icon name="lucide:linkedin" />
      </a>
    </div>

    <p class="copy">© {new Date().getFullYear()} — feito com curiosidade e café</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: 6rem;
    padding: 3rem 1.5rem;
    text-align: center;
  }

  .footer-inner {
    max-width: 700px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .signature {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .name {
    font-weight: 700;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
  }

  .divider {
    color: #444;
  }

  .title {
    color: #888;
    font-size: 0.9rem;
  }

  .contact {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .contact a {
    font-size: 0.85rem;
    color: #555;
    text-decoration: none;
    display: flex;
    align-items: center;
    transition: color 0.2s;
  }

  .contact a:hover {
    color: #fff;
  }

  [data-icon] {
    width: 1.1rem;
    height: 1.1rem;
  }

  .copy {
    font-size: 0.75rem;
    color: #333;
    margin: 0;
  }
</style>