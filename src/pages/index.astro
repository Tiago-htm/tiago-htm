---
import '../styles/global.css';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import img from '../assets/img.png'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<NavBar/>
  <main class="hero">
		<img src={img.src} alt="..." />
  </main>
  <section class="experience">
  <h2>Experiência</h2>

  <div class="job">
    <div class="job-header">
      <span class="company">GF Innovation</span>
      <span class="period">2024 – presente</span>
    </div>
    <span class="role">Backend Developer Intern</span>
    <ul>
      <li>Otimizei pipeline DOCX→PDF com filas e container LibreOffice pré-aquecido, reduzindo ~80% no tempo de conversão</li>
      <li>Refatorei pipeline de preenchimento de templates para processamento em batch com persistência em bulk e webhook assíncrono</li>
    </ul>
  </div>
</section>
<section class="projects">
  <h2>Projetos</h2>

  <div class="project-list">
    <div class="project">
      <div class="project-header">
        <span class="project-name">João Jardineiro</span>
        <span class="project-stack">Angular · NestJS · PostgreSQL</span>
      </div>
      <p>MVP de portfólio e painel administrativo para paisagista autônomo. Gestão de clientes, agendamentos e financeiro.</p>
      <a href="https://github.com/Tiago-htm/JoaoJardineiroMVP" target="_blank">GitHub →</a>
    </div>
  </div>
</section>

<Footer />
</body>

<style>
  .hero {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
  }

  .hero img {
    max-width: 400px;
    width: 100%;
  }

  .experience {
    max-width: 700px;
    margin: 0 auto;
    padding: 4rem 1.5rem;
  }

  .experience h2 {
    font-size: 1.25rem;
    margin-bottom: 2rem;
    color: #888;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .job-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.25rem;
  }

  .company {
    font-weight: 600;
    font-size: 1.1rem;
  }

  .period {
    font-size: 0.85rem;
    color: #888;
  }

  .role {
    font-size: 0.9rem;
    color: #888;
    display: block;
    margin-bottom: 0.75rem;
  }

  .job ul {
    padding-left: 1.25rem;
    line-height: 1.7;
  }

  .job li {
    margin-bottom: 0.5rem;
  }

  .projects {
  max-width: 700px;
  margin: 0 auto;
  padding: 4rem 1.5rem;
}

.projects h2 {
  font-size: 1.25rem;
  margin-bottom: 2rem;
  color: #888;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.project {
  padding: 1.5rem 0;
  border-top: 1px solid #222;
}

.project-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 0.5rem;
}

.project-name {
  font-weight: 600;
  font-size: 1.1rem;
}

.project-stack {
  font-size: 0.8rem;
  color: #888;
}

.project p {
  font-size: 0.95rem;
  line-height: 1.6;
  color: #ccc;
  margin-bottom: 0.75rem;
}

.project a {
  font-size: 0.85rem;
  color: inherit;
  text-decoration: none;
  border-bottom: 1px solid #555;
  padding-bottom: 1px;
}

.project a:hover {
  border-color: #fff;
}
</style>
</html>


  

